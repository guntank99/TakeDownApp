# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.

# Secret used to sign session cookies. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# --- Later phases (leave empty until the matching provider is integrated) ---
DATABASE_URL=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

YOUTUBE_API_KEY=

# --- Demo accounts (prototype) ---
# In development the demo accounts always work (see README).
# In PRODUCTION they are disabled unless BOTH of these are set, so the public
# demo password can never be used against a deployment:
# DEMO_MODE=true
#   A bcrypt hash of a password YOU choose (generate it locally, never commit it):
#   node -e "console.log(require('bcryptjs').hashSync('choose-a-strong-password', 10))"
#   Paste it into the host's environment settings. In a local .env file wrap it in single quotes
#   because it contains '
# --- Data provider ---
# mock (default) or youtube (official YouTube Data API v3, needs YOUTUBE_API_KEY)
# DATA_PROVIDER=mock
# YOUTUBE_REGION=ID
.
# DEMO_PASSWORD_HASH=

# --- Data provider ---
# mock (default) or youtube (official YouTube Data API v3, needs YOUTUBE_API_KEY)
# DATA_PROVIDER=mock
# YOUTUBE_REGION=ID
