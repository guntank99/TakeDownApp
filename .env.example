# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.

# Secret used to sign session cookies. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# ============================================================================
# MODE
# ============================================================================
# demo (default): simulated data + fictional demo accounts, workspace kept in memory.
# live          : NO simulated data, NO demo accounts. Users and records live in PostgreSQL.
# APP_MODE=live

# --- Live mode: database (PostgreSQL, e.g. Supabase "Connection string" from Project Settings > Database) ---
# Tables are created automatically in their own schema "thepower" with Row Level Security enabled.
# Without DATABASE_URL, live mode still runs but keeps data in memory only (a banner warns about it).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# DATABASE_SSL=disable   # only for a local database; TLS is required otherwise

# --- Live mode: the very first administrator (used only while there are no users) ---
# ADMIN_USERNAME=admin
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.org
#   A bcrypt hash of a password YOU choose (generate it locally, never commit it):
#   node -e "console.log(require('bcryptjs').hashSync('choose-a-strong-password', 10))"
#   In a local .env file wrap the hash in single quotes because it contains $
# ADMIN_PASSWORD_HASH=
# After signing in, create the other users under "Pengguna" and change the password in "Pengaturan".

# ============================================================================
# DATA SOURCES
# ============================================================================
# mock (default in demo) or youtube (official YouTube Data API v3, needs YOUTUBE_API_KEY).
# In live mode the base source is empty: content comes from links the team adds ("Video Viral").
# DATA_PROVIDER=youtube
# YOUTUBE_REGION=ID
YOUTUBE_API_KEY=

# --- Halaman Viral Indonesia: feed RSS resmi penerbit berita. Set "false" untuk mematikan. ---
# NEWS_ENABLED=false

# --- Later phases (leave empty until the matching provider is integrated) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ============================================================================
# DEMO ACCOUNTS (APP_MODE=demo only)
# ============================================================================
# In development the demo accounts always work (see README).
# In PRODUCTION they are disabled unless BOTH of these are set, so the public
# demo password can never be used against a deployment:
# DEMO_MODE=true
# DEMO_PASSWORD_HASH=
